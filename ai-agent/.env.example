# ---------------------------------------------------------------- required
# Where Ollama is listening. The model runs locally, so the household's
# figures never leave this machine. From inside Docker on Linux, reach the
# host daemon with http://host.docker.internal:11434 (compose maps it) or
# run the bundled `ollama` service and use http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# The same Postgres the backend writes to. The agent only ever reads it;
# on Postgres the connection is pinned read-only at the session level
# (see app/core/database.py), so a bug cannot mutate the books.
DATABASE_URL=postgresql://ledger:ledger@db:5432/ledger

# Shared secret the backend sends as `Authorization: Bearer <token>`.
# Must match AGENT_SERVICE_TOKEN in the backend's environment.
AGENT_SERVICE_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------- optional
# Must be a tool-calling model — every figure reaches the model through a
# typed tool. llama3.1:8b and qwen3 work; gemma3 has no tool support.
# Pull it first: `ollama pull llama3.1:8b`
AGENT_MODEL=llama3.1:8b
AGENT_SUBAGENT_MODEL=llama3.1:8b
AGENT_TEMPERATURE=0
# Ollama defaults this to 2048, which silently truncates the agent's
# prompt. Raise it if your model and hardware allow.
AGENT_NUM_CTX=16384
AGENT_RECURSION_LIMIT=40
AGENT_TIMEOUT_SECONDS=270
AGENT_CURRENCY=INR
ALLOWED_ORIGINS=*
PORT=8100
